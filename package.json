{
  "name": "estudai",
  "version": "1.0.0",
  "description": "Estudaí! — plataforma colaborativa de estudos com repositório de materiais e comunidades.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/js/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/js/**/*.js\"",
    "db:migrate-sqlite": "node --env-file=.env scripts/migrate-sqlite-to-postgres.js",
    "start:https": "node --env-file-if-exists=.env src/server-https.js",
    "dev:https": "node --watch --env-file-if-exists=.env src/server-https.js",
    "ssl:dev-cert": "sh scripts/generate-dev-cert.sh"
  },
  "dependencies": {
    "@talocode/maillane": "^0.1.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
