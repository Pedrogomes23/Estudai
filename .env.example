# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
PORT=3000

# Conexão com o PostgreSQL (Supabase > Connect > Session pooler > URI).
# Troque [SENHA] pela senha do banco. Se ela tiver caracteres especiais, codifique-os: @ vira %40, # vira %23, / vira %2F.
# NUNCA coloque a senha real neste arquivo de exemplo nem no GitHub: use o seu .env local e o painel do Render.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[SENHA]@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# Opcional: DATABASE_SSL=false (só para Postgres local sem SSL) e DATABASE_POOL_MAX=10.

# Banco usado SOMENTE pelos testes automatizados (npm test). Nunca aponte para o Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estudai_test

# Pasta dos arquivos enviados (apostilas). No Render grátis o disco é apagado a cada deploy (veja o README).
DATA_DIR=./data

# Limite de upload por arquivo, em MB.
UPLOAD_MAX_MB=25

# Duração do login com "Manter conectado", em dias.
SESSION_DAYS=30

# Em produção atrás de proxy HTTPS (Render, Railway, Fly, Nginx...): true.
TRUST_PROXY=false
# Cookie só trafega por HTTPS. Padrão: true quando NODE_ENV=production.
# COOKIE_SECURE=true

# Origens extras permitidas em requisições que alteram dados (separadas por vírgula).
# ALLOWED_ORIGINS=https://www.meudominio.com

# ---- Recuperação de senha (e-mail real via SMTP) ----
# URL pública do site (usada nos links do e-mail). Em produção: https://seudominio.com
PUBLIC_APP_URL=http://localhost:3000

# SMTP – exemplos: Gmail, SendGrid, Mailgun, Amazon SES
# Gmail: use senha de app (conta Google > Segurança > Senhas de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supportestudai@gmail.com
SMTP_PASS=sua senha
MAIL_FROM="Estudaí! <supportestudai@gmail.com>"

# ---- HTTPS direto no Node (npm run start:https) — veja docs/HTTPS.md ----
# No Render/Railway/Fly o HTTPS já é automático: não precisa disto.
# SSL_KEY_PATH=certs/localhost-key.pem
# SSL_CERT_PATH=certs/localhost-cert.pem
# HTTPS_PORT=3443
# HTTP_REDIRECT=true

# ---- Klyra IA (Groq) ----
# Obtenha a chave grátis em: https://console.groq.com/keys
GROQ_API_KEY=
# Modelo padrão (recomendado): qwen/qwen3.8-27b
# Alternativas free: openai/gpt-oss-120b | openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# (legado — ainda aceito se GROQ_API_KEY não existir)
# GEMINI_API_KEY=
# GEMINI_MODEL=
